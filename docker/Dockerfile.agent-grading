# Sandbox image for the agent description grader.
#
# Build context: src/sakura/dataset_creation/agent_grading (the self-contained
# subpackage), NOT the sakura repo root — the container never installs sakura's
# heavy dependency set. The package is importable as top-level `agent_grading`.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ARG CLAUDE_CODE_VERSION=latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

RUN pip install --no-cache-dir "claude-agent-sdk>=0.1.0,<1.0.0" "jinja2>=3.1,<4.0"

COPY . /app/agent_grading
ENV PYTHONPATH=/app

# Claude Code refuses bypassPermissions as root unless IS_SANDBOX is set; the
# container (with a dropped-capability, no-new-privileges sandbox) is the
# security boundary.
ENV IS_SANDBOX=1

WORKDIR /work
ENTRYPOINT ["python", "-m", "agent_grading.entrypoint"]
